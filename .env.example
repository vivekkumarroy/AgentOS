# LLM Provider Configuration
# Supported providers: openai, gemini, anthropic
LLM_PROVIDER=gemini
# Example OpenAI model: gpt-4o-mini
# Example Gemini model: gemini-3.6-flash
LLM_MODEL=gemini-3.6-flash
API_KEY=your_api_key_here
TIMEOUT=60
# LLM Provider
# Recovery Settings
MAX_TASK_RETRIES=3

# Memory and RAG Settings
VECTOR_DB_PATH=./data/chroma
VECTOR_COLLECTION_NAME=agent_long_term_memory
EMBEDDING_MODEL=local
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5

# Tracing Settings
TRACE_STORAGE_PATH=./data/traces.jsonl

# Application Configuration
APP_ENV=development
